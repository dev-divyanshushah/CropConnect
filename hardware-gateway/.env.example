# ─────────────────────────────────────────────────────────────
# CropConnect Hardware Gateway — Configuration
# ─────────────────────────────────────────────────────────────
#
# HOW TO USE:
#   1. Copy this file to .env  (cp .env.example .env)
#   2. Fill in values below
#   3. Restart the gateway (node gateway.js)
#
# This file is safe to commit. Your .env (with real values) is
# in .gitignore and will never be pushed to GitHub.
# ─────────────────────────────────────────────────────────────

# ── Cloud backend URL ────────────────────────────────────────
# Use the Render deployment URL for production, or
# http://localhost:3000 if running the backend locally.
CLOUD_URL=https://cropconnect-backend-p0bo.onrender.com

# ── Serial port ──────────────────────────────────────────────
# Leave empty for auto-detection (recommended).
# Set to a specific port if auto-detection fails.
# Windows examples: COM3, COM7, COM10
# Linux/Mac examples: /dev/ttyUSB0, /dev/ttyACM0
SERIAL_PORT=

# ── Serial baud rate ─────────────────────────────────────────
# Must match SERIAL_BAUD in esp32_gateway.ino (default: 115200)
BAUD_RATE=115200

# ── Cloud poll interval (milliseconds) ──────────────────────
# How often the gateway polls /api/status for irrigation commands.
# Default: 5000 (5 seconds). Do not set below 2000.
POLL_INTERVAL_MS=5000

# ── ACK timeout (milliseconds) ───────────────────────────────
# How long to wait for a COMMAND ACK from ESP32 before retrying.
# Default: 10000 (10 seconds).
ACK_TIMEOUT_MS=10000

# ── Maximum command retries ───────────────────────────────────
# How many times to retry an unACKed command before giving up.
# After giving up, the gateway will re-issue a fresh command on
# the next poll cycle if the desired state still differs.
# Default: 3
MAX_RETRIES=3
