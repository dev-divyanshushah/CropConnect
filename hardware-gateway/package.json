{
  "name": "cropconnect-hardware-gateway",
  "version": "1.0.0",
  "description": "Laptop USB-Serial gateway between ESP32 hardware and CropConnect cloud backend",
  "main": "gateway.js",
  "scripts": {
    "start": "node gateway.js",
    "test-mode": "node gateway.js --test"
  },
  "dependencies": {
    "@serialport/parser-readline": "^12.0.0",
    "dotenv": "^16.4.5",
    "node-fetch": "^2.7.0",
    "serialport": "^12.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "allowScripts": {
    "@serialport/bindings-cpp@12.0.1": true
  }
}
