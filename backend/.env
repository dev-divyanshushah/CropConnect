# ─────────────────────────────────────────────────────────────
# CropConnect Smart Irrigation – Backend Configuration
# ─────────────────────────────────────────────────────────────
#
# HOW TO USE:
#   1. Fill in the values below
#   2. Save this file
#   3. Restart the server (node server.js)
#
# IMPORTANT: Never share this file – it contains your API keys!
# ─────────────────────────────────────────────────────────────

# Get a free API key from: https://openweathermap.org/api
# Sign up → My API Keys → Copy your key → paste it below
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Your farm location (used for weather forecast)
CITY=Delhi
STATE=Delhi

# Soil moisture % below which irrigation will turn ON
# Example: 40 means "if moisture drops below 40%, irrigate"
MOISTURE_THRESHOLD=40

# MOCK MODE:
#   true  = Use fake sensor values (for testing without hardware)
#   false = Use real data from ESP8266 masters
MOCK_MODE=true

# Server port (leave as 3000 unless you have a reason to change)
PORT=3000
